// Modelo de dados definido em docs/database/schema.md — models entram via migration,
// junto do Service/Repository que os motiva (ver docs/database/migrations-prisma.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleMembro {
  owner
  admin
  padrao
}

// Escopo de um comentário: a entidade à qual ele está ancorado. Cresce junto com o
// domínio (caso, prazo...) sem precisar de uma tabela de comentários por entidade.
enum EscopoComentario {
  cliente
  caso
}

enum EscopoDocumento {
  cliente
  caso
}

enum TipoArquivo {
  pdf
  docx
  jpg
  png
  jpeg
}

enum EntidadeLog {
  cliente
  comentario
  caso
  status
  tipo_processo
  membro
  documento
  instancia_whatsapp
  campanha
  evento
}

enum AcaoLog {
  criar
  atualizar
  excluir
  restaurar
}

enum SexoCliente {
  masculino
  feminino
  outro
}

enum EstadoCivilCliente {
  solteiro
  casado
  divorciado
  viuvo
  uniao_estavel
}

enum StatusInstanciaWhatsapp {
  disconnected
  connecting
  connected
  hibernated
}

// Espelha 1:1 o ciclo de vida de uma campanha na UAZAPI (scheduled/sending/paused/done/
// deleting), traduzido para o vocabulário do resto do schema. `excluindo` existe porque o
// delete do /sender/edit é assíncrono lá — o estado é observável enquanto não conclui.
enum StatusCampanha {
  agendada
  enviando
  pausada
  concluida
  excluindo
}

// Modalidade de um evento da agenda (RN32): `presencial` exige `local`, `online` exige
// `link_reuniao`. Um enum em vez de dois booleanos porque as duas modalidades são
// mutuamente exclusivas e cada uma tem um campo obrigatório diferente.
enum ModalidadeEvento {
  presencial
  online
}

model Escritorio {
  id               String   @id @default(uuid())
  nome             String   @db.VarChar(140)
  oabResponsavel   String?  @map("oab_responsavel") @db.VarChar(20)
  telefoneWhatsapp String?  @map("telefone_whatsapp") @db.VarChar(20)
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  membros            Membro[]
  convites           Convite[]
  clientes           Cliente[]
  comentarios        Comentario[]
  logs               Log[]
  status             Status[]
  tiposProcesso      TipoProcesso[]
  casos              Caso[]
  documentos         Documento[]
  instanciasWhatsapp InstanciaWhatsapp[]
  campanhas          Campanha[]
  campanhaItens      CampanhaItem[]
  eventos            Evento[]

  @@map("escritorio")
}

// Perfil global do usuário — não pertence a um único escritório; a associação
// N:N com papel por tenant vive em Membro.
model Usuario {
  id        String   @id @default(uuid())
  nome      String   @db.VarChar(140)
  email     String   @unique @db.VarChar(255)
  senhaHash String   @map("senha_hash") @db.VarChar(255)
  avatarUrl String?  @map("avatar_url") @db.VarChar(500)
  oab       String?  @db.VarChar(20)
  telefone  String?  @db.VarChar(20)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  membros          Membro[]
  convitesEnviados Convite[]    @relation("ConviteCriadoPor")
  comentarios      Comentario[] @relation("ComentarioAutor")
  logs             Log[]        @relation("LogAutor")
  campanhas        Campanha[]   @relation("CampanhaCriadaPor")

  @@map("usuario")
}

// Tabela híbrida: associação de um usuário a um escritório com um papel (RN02a).
model Membro {
  id           String     @id @default(uuid())
  usuarioId    String     @map("usuario_id")
  escritorioId String     @map("escritorio_id")
  role         RoleMembro @default(padrao)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  usuario             Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  escritorio          Escritorio           @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  casos               Caso[]
  documentos          Documento[]
  eventosCriados      Evento[]             @relation("EventoCriadoPor")
  participacoesEvento EventoParticipante[]

  @@unique([usuarioId, escritorioId])
  @@index([escritorioId])
  @@index([usuarioId])
  @@map("membro")
}

// Convite pendente para um e-mail entrar num escritório com um papel. Linha existe =
// convite pendente; aceitar/cancelar remove a linha (evita índice parcial — RFC).
model Convite {
  id                 String     @id @default(uuid())
  escritorioId       String     @map("escritorio_id")
  email              String     @db.VarChar(255)
  role               RoleMembro @default(padrao)
  criadoPorUsuarioId String     @map("criado_por_usuario_id")
  expiraEm           DateTime   @map("expira_em")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  criadoPor  Usuario    @relation("ConviteCriadoPor", fields: [criadoPorUsuarioId], references: [id])

  @@unique([escritorioId, email])
  @@index([email])
  @@map("convite")
}

// Cliente do escritório. Nunca é apagado (RN04): "desativar" grava soft_deleted_at,
// e cliente ativo é simplesmente soft_deleted_at = null.
model Cliente {
  id            String              @id @default(uuid())
  escritorioId  String              @map("escritorio_id")
  nome          String              @db.VarChar(140)
  cpf           String              @db.VarChar(11)
  email         String?             @db.VarChar(140)
  telefone      String?             @db.VarChar(20)
  endereco      String?             @db.VarChar(255)
  sexo          SexoCliente?
  estadoCivil   EstadoCivilCliente? @map("estado_civil")
  nomeMae       String?             @map("nome_mae") @db.VarChar(140)
  nomePai       String?             @map("nome_pai") @db.VarChar(140)
  nacionalidade String?             @db.VarChar(60)
  nascimento    DateTime?           @db.Date
  profissao     String?             @db.VarChar(100)
  softDeletedAt DateTime?           @map("soft_deleted_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  casos      Caso[]
  eventos    Evento[]

  @@unique([escritorioId, cpf])
  @@index([escritorioId, softDeletedAt])
  @@map("cliente")
}

// Comentário ancorado numa entidade via (escopo, escopo_id) — sem FK, porque o alvo
// varia. O isolamento continua vindo de escritorio_id (RN19).
model Comentario {
  id             String           @id @default(uuid())
  escritorioId   String           @map("escritorio_id")
  escopo         EscopoComentario
  escopoId       String           @map("escopo_id")
  autorUsuarioId String           @map("autor_usuario_id")
  conteudo       String           @db.Text
  editadoEm      DateTime?        @map("editado_em")
  softDeletedAt  DateTime?        @map("soft_deleted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  autor      Usuario    @relation("ComentarioAutor", fields: [autorUsuarioId], references: [id], onDelete: Restrict)

  @@index([escritorioId, escopo, escopoId, createdAt])
  @@map("comentario")
}

// Documento anexado a um cliente ou caso (escopo, escopo_id — mesmo padrão de
// Comentario), armazenado no S3 via storage_key (RN17/RN18).
model Documento {
  id            String          @id @default(uuid())
  escritorioId  String          @map("escritorio_id")
  escopo        EscopoDocumento
  escopoId      String          @map("escopo_id")
  autorMembroId String          @map("autor_membro_id")
  nomeOriginal  String          @map("nome_original") @db.VarChar(255)
  tipoArquivo   TipoArquivo     @map("tipo_arquivo")
  tamanhoKb     Int             @map("tamanho_kb")
  storageKey    String          @map("storage_key") @db.VarChar(500)
  softDeletedAt DateTime?       @map("soft_deleted_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  autor      Membro     @relation(fields: [autorMembroId], references: [id], onDelete: Restrict)

  @@index([escritorioId, escopo, escopoId, softDeletedAt])
  @@map("documento")
}

// Trilha de auditoria transversal (RN20): quem fez (usuario_id), quando fez (created_at)
// e o que fez (acao + entidade + entidade_id + resumo + diff em dados).
// Append-only: sem updated_at, e o Repository não expõe update/delete.
model Log {
  id           String      @id @default(uuid())
  escritorioId String      @map("escritorio_id")
  usuarioId    String      @map("usuario_id")
  acao         AcaoLog
  entidade     EntidadeLog
  entidadeId   String      @map("entidade_id")
  resumo       String      @db.VarChar(255)
  dados        Json?
  createdAt    DateTime    @default(now()) @map("created_at")

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  usuario    Usuario    @relation("LogAutor", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([escritorioId, createdAt])
  @@index([escritorioId, entidade, entidadeId])
  @@map("log")
}

// Referência global do sistema: os tipos de status padronizam o funil de todos os
// escritórios. Só o desenvolvedor administrador altera esta tabela (via migration);
// nenhum endpoint de escrita é exposto para ela.
model TipoStatus {
  id        String  @id @default(uuid())
  chave     String  @unique @db.VarChar(30)
  nome      String  @db.VarChar(60)
  icone     String  @db.VarChar(60)
  cor       String  @db.VarChar(9)
  descricao String? @db.VarChar(255)
  ordem     Int

  status Status[]

  @@map("tipo_status")
}

// Status do funil de um escritório, associado a um TipoStatus para permitir
// agrupamento/relatórios comparáveis entre escritórios diferentes.
model Status {
  id           String   @id @default(uuid())
  escritorioId String   @map("escritorio_id")
  tipoStatusId String   @map("tipo_status_id")
  nome         String   @db.VarChar(60)
  icone        String   @db.VarChar(60)
  cor          String   @db.VarChar(9)
  descricao    String?  @db.VarChar(255)
  ordem        Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  tipo       TipoStatus @relation(fields: [tipoStatusId], references: [id], onDelete: Restrict)
  casos      Caso[]

  @@unique([escritorioId, nome])
  @@index([escritorioId, ordem])
  @@map("status")
}

// Tipo de processo do escritório: padroniza a natureza do caso ("Juros abusivos",
// "Aposentadoria") no lugar do antigo título livre de Caso. Mesma anatomia de Status
// (nome + cor + ícone + ordem), mas sem nível global — o tipo é do tenant e ponto.
model TipoProcesso {
  id           String   @id @default(uuid())
  escritorioId String   @map("escritorio_id")
  nome         String   @db.VarChar(60)
  icone        String   @db.VarChar(60)
  cor          String   @db.VarChar(9)
  descricao    String?  @db.VarChar(255)
  ordem        Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  casos      Caso[]

  @@unique([escritorioId, nome])
  @@index([escritorioId, ordem])
  @@map("tipo_processo")
}

// Caso do escritório: sempre vinculado a um cliente ativo e a um status (RN06/RN07).
// Responsável é opcional ("sem responsável") e vira null se o membro for removido.
model Caso {
  id                  String   @id @default(uuid())
  escritorioId        String   @map("escritorio_id")
  clienteId           String   @map("cliente_id")
  statusId            String   @map("status_id")
  responsavelMembroId String?  @map("responsavel_membro_id")
  tipoProcessoId      String   @map("tipo_processo_id")
  numeroProcesso      String?  @map("numero_processo") @db.VarChar(25)
  descricao           String?  @db.Text
  valor               Decimal? @db.Decimal(12, 2)
  arquivado           Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  escritorio   Escritorio   @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  status       Status       @relation(fields: [statusId], references: [id], onDelete: Restrict)
  tipoProcesso TipoProcesso @relation(fields: [tipoProcessoId], references: [id], onDelete: Restrict)
  responsavel  Membro?      @relation(fields: [responsavelMembroId], references: [id], onDelete: SetNull)
  eventos      Evento[]

  @@index([escritorioId, arquivado, statusId, createdAt])
  @@index([escritorioId, clienteId])
  @@index([escritorioId, responsavelMembroId])
  @@index([escritorioId, tipoProcessoId])
  @@map("caso")
}

// Instância WhatsApp: vinculação entre um escritório e uma instância UAZAPI para envio de mensagens.
// Cada escritório pode ter múltiplas instâncias (ex.: diferentes números/bots). O status acompanha
// o ciclo de conexão (desconectado → conectando → conectado; hibernado se inativo).
// Nunca é apagada fisicamente (RN30): "excluir" grava soft_deleted_at (ativa = NULL), porque esta
// linha é a única cópia do uazapi_token — sem ela, toda campanha daquela instância perde o canal
// de controle com a UAZAPI e nunca mais pode ser sincronizada, pausada ou excluída.
model InstanciaWhatsapp {
  id               String                  @id @default(uuid())
  escritorioId     String                  @map("escritorio_id")
  nome             String                  @db.VarChar(60)
  uazapiInstanceId String                  @map("uazapi_instance_id") @db.VarChar(100)
  uazapiToken      String                  @map("uazapi_token") @db.VarChar(255)
  status           StatusInstanciaWhatsapp @default(disconnected)
  numeroConectado  String?                 @map("numero_conectado") @db.VarChar(20)
  fotoPerfilUrl    String?                 @map("foto_perfil_url")
  softDeletedAt    DateTime?               @map("soft_deleted_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  campanhas  Campanha[]

  // O unique abrange as soft-deletadas de propósito (mesma escolha de Cliente com o CPF):
  // manter o nome reservado é o que torna segura a ressurreição feita por sincronizarTodas
  // quando a instância reaparece na UAZAPI — sem isso, um nome reaproveitado no intervalo
  // faria a restauração estourar P2002 e derrubar o lote inteiro.
  @@unique([escritorioId, nome])
  @@index([escritorioId])
  @@index([escritorioId, softDeletedAt])
  @@map("instancia_whatsapp")
}

// Campanha de disparo em massa: um CSV de destinatários + uma mensagem-modelo com
// {{variaveis}}, materializados em N mensagens (CampanhaItem) e registrados na UAZAPI via
// POST /sender/advanced — que devolve o `uazapi_folder_id` usado depois para sincronizar
// estatísticas (/sender/listfolders) e controlar o envio (/sender/edit).
model Campanha {
  id                  String         @id @default(uuid())
  escritorioId        String         @map("escritorio_id")
  instanciaWhatsappId String?        @map("instancia_whatsapp_id")
  criadoPorId         String         @map("criado_por_id")
  nome                String         @db.VarChar(120)
  mensagemTemplate    String         @map("mensagem_template") @db.Text
  // {{variavel}} -> nome da coluna do CSV que a preenche. Guardado para a tela de detalhe
  // explicar de onde veio cada valor, já que o CSV em si não é persistido.
  mapeamentoVariaveis Json?          @map("mapeamento_variaveis")
  colunaNumero        String         @map("coluna_numero") @db.VarChar(120)
  arquivoCsvNome      String?        @map("arquivo_csv_nome") @db.VarChar(255)
  delayMin            Int            @map("delay_min")
  delayMax            Int            @map("delay_max")
  agendadaPara        DateTime?      @map("agendada_para")
  status              StatusCampanha @default(agendada)
  uazapiFolderId      String         @map("uazapi_folder_id") @db.VarChar(100)
  totalDestinatarios  Int            @map("total_destinatarios")
  // Contadores espelhados do /sender/listfolders na última sincronização — a UAZAPI é a
  // fonte da verdade do envio; aqui é só cache para a listagem não depender dela.
  logTotal            Int            @default(0) @map("log_total")
  logSucesso          Int            @default(0) @map("log_sucesso")
  logFalha            Int            @default(0) @map("log_falha")
  logEntregue         Int            @default(0) @map("log_entregue")
  logLido             Int            @default(0) @map("log_lido")
  logReproduzido      Int            @default(0) @map("log_reproduzido")
  sincronizadoEm      DateTime?      @map("sincronizado_em")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  escritorio Escritorio         @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  // SetNull, e não Restrict: a aplicação não apaga mais instância fisicamente (RN30 — a
  // exclusão é soft, via soft_deleted_at), então esta ação referencial só existe como rede
  // de segurança para uma remoção feita fora da aplicação. Restrict aqui quebraria o DELETE
  // de Escritorio, cujo cascade apaga campanha e instancia_whatsapp juntas: no Postgres o
  // RESTRICT é checado imediatamente e não pode ser adiado até o fim do statement.
  // instancia_whatsapp_id nulo só existe em campanhas anteriores ao soft delete; elas seguem
  // como histórico somente-leitura (sem token, não dá para sincronizar nem controlar).
  instancia  InstanciaWhatsapp? @relation(fields: [instanciaWhatsappId], references: [id], onDelete: SetNull)
  criadoPor  Usuario            @relation("CampanhaCriadaPor", fields: [criadoPorId], references: [id], onDelete: Restrict)
  itens      CampanhaItem[]

  @@index([escritorioId, createdAt])
  @@index([instanciaWhatsappId])
  @@map("campanha")
}

// Uma mensagem já renderizada para um destinatário — o que de fato foi entregue à UAZAPI.
// Snapshot imutável (sem updated_at, como Log): reprocessar o template depois daria um
// texto diferente do que o cliente recebeu.
model CampanhaItem {
  id           String   @id @default(uuid())
  escritorioId String   @map("escritorio_id")
  campanhaId   String   @map("campanha_id")
  linha        Int
  numero       String   @db.VarChar(20)
  mensagem     String   @db.Text
  variaveis    Json?
  createdAt    DateTime @default(now()) @map("created_at")

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  campanha   Campanha   @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  @@unique([campanhaId, linha])
  @@index([campanhaId])
  @@index([escritorioId])
  @@map("campanha_item")
}

// Evento da agenda do escritório (RN31): compromisso com início e fim, visível a todo
// membro do tenant. O vínculo é opcional e exclusivo — caso_id XOR cliente_id — porque um
// evento pode ser um compromisso interno sem parte envolvida; a exclusividade é garantida
// pelo Service, não por constraint, para o erro chegar ao usuário como 422 e não como
// violação de banco. Nunca é apagado fisicamente: "excluir" grava soft_deleted_at (RN34),
// mantendo o histórico de quem marcou e desmarcou o quê.
model Evento {
  id                String           @id @default(uuid())
  escritorioId      String           @map("escritorio_id")
  titulo            String           @db.VarChar(140)
  descricao         String?          @db.Text
  inicio            DateTime
  fim               DateTime
  diaInteiro        Boolean          @default(false) @map("dia_inteiro")
  modalidade        ModalidadeEvento
  local             String?          @db.VarChar(255)
  linkReuniao       String?          @map("link_reuniao") @db.VarChar(500)
  clienteId         String?          @map("cliente_id")
  casoId            String?          @map("caso_id")
  criadoPorMembroId String           @map("criado_por_membro_id")
  softDeletedAt     DateTime?        @map("soft_deleted_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  escritorio    Escritorio           @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  cliente       Cliente?             @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  caso          Caso?                @relation(fields: [casoId], references: [id], onDelete: SetNull)
  criadoPor     Membro               @relation("EventoCriadoPor", fields: [criadoPorMembroId], references: [id], onDelete: Restrict)
  participantes EventoParticipante[]

  @@index([escritorioId, inicio])
  @@index([escritorioId, softDeletedAt, inicio])
  @@index([escritorioId, casoId])
  @@index([escritorioId, clienteId])
  @@index([escritorioId, criadoPorMembroId])
  @@map("evento")
}

// Participação de um membro num evento (RN33). Tabela de junção pura e imutável (sem
// updated_at): a edição de participantes é feita substituindo o conjunto de linhas. Não
// carrega escritorio_id porque só é alcançável através de `evento`, que já é escopado —
// o tenant vem de lá em toda query (RN19).
model EventoParticipante {
  id        String   @id @default(uuid())
  eventoId  String   @map("evento_id")
  membroId  String   @map("membro_id")
  createdAt DateTime @default(now()) @map("created_at")

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  membro Membro @relation(fields: [membroId], references: [id], onDelete: Cascade)

  @@unique([eventoId, membroId])
  @@index([membroId])
  @@map("evento_participante")
}
