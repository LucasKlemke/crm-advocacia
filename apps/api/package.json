{
  "name": "@crm/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentacao.ts src/main.ts",
    "build": "tsup",
    "start": "node --enable-source-maps --import ./dist/instrumentacao.mjs dist/main.mjs",
    "vercel-build": "prisma generate && node scripts/migrar-no-deploy.mjs && tsup",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "migrar": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@crm/compartilhado": "*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/client": "^6.19.3",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jose": "^6.2.9",
    "newrelic": "^13.0.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@swc/core": "^1.13.0",
    "@swc/jest": "^0.2.39",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/newrelic": "^9.14.8",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.2",
    "aws-sdk-client-mock": "^4.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=24"
  }
}
