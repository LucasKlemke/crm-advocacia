# Copie para apps/api/.env — detalhes em docs/deploy/deploy.md

# --- Banco (docker-compose.yml) ---
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5432/crm_advocacia?schema=public"
DIRECT_URL="postgresql://crm_user:crm_password@localhost:5432/crm_advocacia?schema=public"

# --- Auth --- gere com: openssl rand -base64 32
AUTH_SECRET="troque-me"

# --- Servidor ---
API_PORT=3001

# --- S3 --- chaves: https://console.aws.amazon.com/iam/home#/users
AWS_ACCESS_KEY_ID="troque-me"
AWS_SECRET_ACCESS_KEY="troque-me"
AWS_REGION="us-east-2"
AWS_S3_BUCKET="sistema-advogado-lucas-quintino"
AWS_S3_PREFIX="development"
AWS_S3_ENDPOINT=""   # vazio = AWS; preencha p/ S3-compatível (Supabase Storage)

# --- WhatsApp (UAZAPI) --- https://uazapi.com
UAZAPI_SERVER_URL="https://lucasklemke2.uazapi.com"
UAZAPI_ADMIN_TOKEN="troque-me"

# --- Tempo real (opcional) --- docs/arquitetura/tempo-real.md
API_PUBLIC_URL=""          # URL do ngrok (npm run dev:tunnel); vazio = sem webhook
UAZAPI_WEBHOOK_SECRET=""   # gere com: openssl rand -base64 32
WEB_ORIGINS=""
TEMPO_REAL_HABILITADO=""
TEMPO_REAL_POLLING_MS=15000

# --- New Relic (opcional, só produção) --- https://one.newrelic.com/api-keys
NEW_RELIC_LICENSE_KEY=""
NEW_RELIC_APP_NAME="crm-advocacia-api (local)"
